  "shape_caveat_rules": [
    {
      "shape": "skewed",
      "applies_to": [
        "histogram",
        "density",
        "scatter",
        "bubble"
      ],
      "caveat": "Consider log scale",
      "transform": "Scale_Y_Log10() — or Scale_X_Log10(), per the skewed axis"
    },
    {
      "shape": "power_law",
      "applies_to": [
        "scatter",
        "connected_scatter"
      ],
      "caveat": "Consider log-log scale",
      "transform": "Scale_X_Log10() + Scale_Y_Log10()"
    },
    {
      "shape": "bimodal",
      "applies_to": [
        "boxplot",
        "barplot"
      ],
      "caveat": "Summaries hide bimodality; prefer violin/ridgeline"
    }
