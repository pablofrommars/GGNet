@inherits LayoutComponentBase

<div class="min-h-screen">
    <header class="border-b border-gray-200 bg-white">
        <nav class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 px-6 py-3">
            <span class="font-semibold">GGNet Demo</span>
            <NavLink href="/" Match=NavLinkMatch.All class="text-sm text-gray-600 hover:text-gray-900">Home</NavLink>
            <NavLink href="/external-controls" class="text-sm text-gray-600 hover:text-gray-900">External controls</NavLink>
            <NavLink href="/wheel-zoom" class="text-sm text-gray-600 hover:text-gray-900">Wheel zoom</NavLink>
            <NavLink href="/crosshair" class="text-sm text-gray-600 hover:text-gray-900">Crosshair</NavLink>
            <NavLink href="/drag-pan" class="text-sm text-gray-600 hover:text-gray-900">Drag pan</NavLink>
            <NavLink href="/tooltips" class="text-sm text-gray-600 hover:text-gray-900">Tooltips</NavLink>
            <NavLink href="/combined" class="text-sm text-gray-600 hover:text-gray-900">Combined</NavLink>
            <NavLink href="/touch" Match=NavLinkMatch.All class="text-sm text-gray-600 hover:text-gray-900">Touch</NavLink>
            <NavLink href="/touch-layout" class="text-sm text-gray-600 hover:text-gray-900">Touch layout</NavLink>
            <NavLink href="/overview-detail" class="text-sm text-gray-600 hover:text-gray-900">Overview and detail</NavLink>
            <NavLink href="/time-cursor" class="text-sm text-gray-600 hover:text-gray-900">Time cursor</NavLink>
            @* Feature pages register here as interactivity blocks land. *@
        </nav>
        @* Identifies the deployed build during device QA: version plus source revision.
           At the top, clear of the contact diagnostic fixed to the bottom of the touch pages. *@
        <div data-qa="build" class="mx-auto max-w-5xl px-6 pb-2 font-mono text-xs text-gray-400">
            GGNet.Demo @BuildInfo.Version
        </div>
    </header>

    <main class="mx-auto max-w-5xl px-6 py-8">
        @Body
    </main>
</div>
