@page "/touch-layout"
@rendermode InteractiveServer

<PageTitle>Touch layout — GGNet Demo</PageTitle>

<h1 class="text-2xl font-semibold">Touch: scrolling, dialogs and lifetime</h1>

<p class="mt-2 max-w-prose text-gray-600">
    The same gestures where a chart is embedded: inside a scroll container,
    inside a modal dialog, at a changing size, and across mounting and
    navigation.
</p>

<h2 class="mt-6 text-xl font-semibold">Nested scroll container</h2>

<p class="mt-2 max-w-prose text-gray-600">
    The box scrolls both ways. Starting on text, a swipe scrolls the box.
    Starting on the chart, a horizontal swipe pans it and a vertical swipe
    still scrolls the box.
</p>

<div data-qa="scroller" class="mt-4 h-96 overflow-auto rounded-lg border border-gray-300 bg-white p-4">
    <div style="width: 150%;">
        <p class="text-gray-600">Scroll this box down and sideways. Filler rows follow.</p>
        @for (var i = 1; i <= 6; i++)
        {
            <p class="mt-3 text-gray-400">Filler row @i above the chart — start a swipe here to scroll the box.</p>
        }
        <div data-qa="nested" class="mt-4 rounded-lg border border-gray-200 p-2" style="width: 60%;">
            <Plot Context=@nestedContext RenderMode=@renderMode Interactivity=@inspect />
        </div>
        @for (var i = 1; i <= 10; i++)
        {
            <p class="mt-3 text-gray-400">Filler row @i below the chart.</p>
        }
    </div>
</div>

<h2 class="mt-8 text-xl font-semibold">Modal dialog</h2>

<p class="mt-2 max-w-prose text-gray-600">
    The chart mounts when the dialog opens and is disposed when it closes. The
    tooltip must appear above the dialog. The dialog is half the screen tall,
    so its body always scrolls, and a swipe there never scrolls the page.
</p>

<button data-qa="open-dialog" class="mt-3 rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=OpenDialog>Open dialog (opened @dialogOpens×)</button>

<dialog @ref=dialog data-qa="dialog" class="m-auto w-11/12 max-w-3xl rounded-lg p-4 shadow-xl" style="height: 50vh; overflow: auto; overscroll-behavior: contain;" @onclose=CloseDialog>
    @if (dialogOpen)
    {
        <div class="flex items-center justify-between">
            <h3 class="text-lg font-semibold">Chart in a modal dialog</h3>
            <form method="dialog">
                <button data-qa="close-dialog" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100">Close</button>
            </form>
        </div>
        <div data-qa="dialog-chart" class="mt-3">
            <Plot Context=@dialogContext RenderMode=@renderMode Interactivity=@inspect />
        </div>
        @for (var i = 1; i <= 12; i++)
        {
            <p class="mt-3 text-gray-400">Dialog filler row @i — swipe here to scroll the dialog.</p>
        }
    }
</dialog>

<h2 class="mt-8 text-xl font-semibold">Responsive size</h2>

<p class="mt-2 max-w-prose text-gray-600">
    The chart scales with its container. Taps, pans and tooltips must land
    where the finger is at every width.
</p>

<div class="mt-3 flex flex-wrap gap-2">
    @foreach (var option in widths)
    {
        <button data-qa="width-@option" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=@(() => width = option)>@option%</button>
    }
</div>

<div data-qa="responsive" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm" style="width: @(width)%;">
    <Plot Context=@responsiveContext RenderMode=@renderMode Interactivity=@inspect />
</div>

<h2 class="mt-8 text-xl font-semibold">Mount and dispose</h2>

<p class="mt-2 max-w-prose text-gray-600">
    Unmount and remount the chart, or leave this page and return. Every tap
    must still raise the counter by exactly one, and one drag must shift the
    axis once.
</p>

<div class="mt-3 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
    <button data-qa="toggle-mount" class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=ToggleMount>@(mounted ? "Unmount chart" : "Mount chart")</button>
    <span>Mounts <b data-qa="mounts">@mounts</b></span>
    <span>Mark callbacks <b data-qa="mount-clicks" class="text-lg">@markClicks</b></span>
</div>

<div data-qa="mount" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm" style="min-height: 6rem;">
    @if (mounted)
    {
        <Plot @key=mounts Context=@mountContext RenderMode=@renderMode Interactivity=@inspect />
    }
    else
    {
        <p class="text-gray-400">Chart unmounted.</p>
    }
</div>

<div class="h-40"></div>

<ContactDiagnostics @ref=diagnostics />
