@page "/crosshair"
@rendermode InteractiveServer

<PageTitle>Crosshair — GGNet Demo</PageTitle>

<h1 class="text-2xl font-semibold">Crosshair &amp; readout</h1>

<p class="mt-2 max-w-prose text-gray-600">
    Move the pointer over the panel: a vertical crosshair follows with the x
    value read out through the scale's formatter. Wheel zoom stays active on
    the same plot — the two gestures compose.
</p>

<div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot Context=@context RenderMode=@renderMode Interactivity=@interactivity />
</div>
