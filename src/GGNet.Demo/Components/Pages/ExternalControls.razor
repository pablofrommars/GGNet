@page "/external-controls"
@rendermode InteractiveServer

<PageTitle>External controls — GGNet Demo</PageTitle>

<h1 class="text-2xl font-semibold">External controls</h1>

<p class="mt-2 max-w-prose text-gray-600">
    Host-owned buttons drive the view window through the Plot @@ref commands:
    zoom to an explicit range, show the trailing window, reset. The window
    survives re-renders until reset.
</p>

<div class="mt-4 flex flex-wrap gap-2">
    <button class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=ZoomToMidWeekAsync>Zoom: day 2–4</button>
    <button class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=ShowLastTwoDaysAsync>Last 48 h</button>
    <button class="rounded-md border border-gray-300 bg-white px-3 py-1.5 text-sm hover:bg-gray-100" @onclick=ResetAsync>Reset</button>
</div>

<div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot @ref=plot Context=@context RenderMode=@renderMode />
</div>
