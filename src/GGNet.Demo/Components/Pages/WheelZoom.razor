@page "/wheel-zoom"
@rendermode InteractiveServer

<PageTitle>Wheel zoom — GGNet Demo</PageTitle>

<h1 class="text-2xl font-semibold">Wheel zoom</h1>

<p class="mt-2 max-w-prose text-gray-600">
    The first in-chart gesture: scroll to zoom the x axis about the cursor,
    double-click to reset to the authored view. Interactivity is opt-in via the
    <code class="rounded bg-gray-100 px-1">Interactivity</code> parameter — the
    plot below fixes to its viewBox size so pointer offsets map to plot units.
</p>

<div class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot Context=@context RenderMode=@renderMode Interactivity=@interactivity />
</div>
