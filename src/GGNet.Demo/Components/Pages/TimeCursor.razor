@page "/time-cursor"
@rendermode InteractiveServer

<PageTitle>Time cursor — GGNet Demo</PageTitle>

<h1 class="text-2xl font-semibold">Time cursor</h1>

<p class="mt-2 max-w-prose text-gray-600">
    Tap or click a panel to pin a moment; drag sideways with one finger to
    scrub. The line crosses every panel at the same time, and each series
    reports the sample it actually has there: no two series here are sampled
    at the same instant. Two fingers pan and pinch the time window; a mouse
    drags to pan. Only Clear ends the inspection. The readout keeps a fixed
    height: one that grew when a reading arrived would move the chart under
    the pointer.
</p>

<div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
    <button class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm hover:bg-gray-100" data-qa="clear" disabled=@(inspection is null) @onclick=ClearAsync>Clear</button>
    <button class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm hover:bg-gray-100" data-qa="reset" @onclick=ResetAsync>Reset view</button>
    <button class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm hover:bg-gray-100" data-qa="append" @onclick=AppendAsync>Append readings</button>
    <button class="rounded-md border border-gray-300 bg-white px-4 py-2 text-sm hover:bg-gray-100" data-qa="replace" @onclick=Replace>New context</button>
</div>

<div class="mt-3 h-64 overflow-hidden rounded-lg border border-gray-200 bg-white p-4 text-sm shadow-sm" data-qa="readout">
    @if (readings is { Inspection: { } position })
    {
        <div class="flex flex-wrap items-baseline gap-x-4">
            <span class="text-base font-semibold" data-qa="cursor-time">@Time(position.X)</span>
            <span class="text-gray-500" data-qa="pinned">@(position.Pinned ? "pinned" : "following")</span>
            @if (readings.OutsideView)
            {
                <span class="rounded bg-amber-100 px-2 py-0.5 text-amber-800" data-qa="outside">outside the view</span>
            }
        </div>

        <table class="mt-2 w-full">
            <tbody>
                @foreach (var reading in readings.Values)
                {
                    <tr data-qa-row=@reading.Name data-qa-kind=@reading.Kind>
                        <td class="py-0.5 pr-4 text-gray-600">@reading.Name</td>
                        <td class=@(reading.Kind == ReadingKind.Missing ? "pr-4 italic text-gray-400" : "pr-4 font-mono font-semibold") data-qa-value>@reading.Value</td>
                        <td class="text-gray-500" data-qa-note>@Note(reading)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <span class="text-gray-500" data-qa="empty">Nothing inspected.</span>
    }
</div>

<div class="mt-2 flex flex-wrap items-center gap-x-6 gap-y-1 font-mono text-xs text-gray-600">
    <span>position changes <b data-qa="position-changes">@positionChanges</b></span>
    <span>readout changes <b data-qa="readout-changes">@readoutChanges</b></span>
    <span>view changes <b data-qa="view-changes">@viewChanges</b></span>
    <span>window <b data-qa="window">@window</b> (<b data-qa="window-minutes">@windowMinutes</b> min)</span>
    <span>mark clicks <b data-qa="mark-clicks">@markClicks</b></span>
    <span>ancestor clicks <b data-qa="ancestor-clicks">@ancestorClicks</b></span>
</div>

<div data-qa="cursor" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm" @onclick=@(() => ancestorClicks++)>
    <Plot T="Sample" TX="Instant" TY="double" @ref=plot Context=@context RenderMode=@renderMode Interactivity=@interactivity
          Height="760"
          Inspection=@inspection InspectionChanged=@OnInspectionChanged ReadingsChanged=@OnReadingsChanged ViewChanged=@OnViewChanged />
</div>

<h2 class="mt-8 text-xl font-semibold">Crosshair without navigation</h2>

<p class="mt-2 max-w-prose text-gray-600">
    The same crosshair with no readout and no <code>Pan</code>: two fingers
    still pinch the page here.
</p>

<div data-qa="plain" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot Context=@plainContext RenderMode=@renderMode Interactivity=@crosshairOnly Height="320" />
</div>

<h2 class="mt-8 text-xl font-semibold">Snapped axes</h2>

<p class="mt-2 max-w-prose text-gray-600">
    On a discrete axis the line snaps to the category under the pointer.
</p>

<div data-qa="snap" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot Context=@snapContext RenderMode=@renderMode Interactivity=@crosshairOnly Height="320" />
</div>

<h2 class="mt-8 text-xl font-semibold">Independent x axes</h2>

<p class="mt-2 max-w-prose text-gray-600">
    Facets with their own x scale share no time: the line stays in the panel
    under the pointer and does not pin.
</p>

<div data-qa="free" class="mt-4 rounded-lg border border-gray-200 bg-white p-4 shadow-sm">
    <Plot Context=@freeContext RenderMode=@renderMode Interactivity=@crosshairOnly Height="320" />
</div>
