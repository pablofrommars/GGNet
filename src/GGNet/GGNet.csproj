<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PackageDescription>GG.Net lets Data Scientists and Developers create flexible charts for .Net in C# and F#</PackageDescription>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="GGNet.Headless" />
        <InternalsVisibleTo Include="GGNet.Headless.Tests" />
        <!-- Lets Moq/Castle DynamicProxy mock internal interfaces (e.g. IPlotRendering) in tests. -->
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Themes\*.css" />
    </ItemGroup>

    <ItemGroup>
        <ThemeCssFiles Include="Themes\*.css" />
        <_CurrentProjectDiscoveredScopedCssFiles Include="@(ThemeCssFiles)" RelativePath="%(Identity)" BasePath="_content/$(AssemblyName)" />
    </ItemGroup>

    <ItemGroup>
        <Content Remove="wwwroot\dev\**\*" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
        <PackageReference Include="Microsoft.Extensions.ObjectPool" />
        <PackageReference Include="NodaTime" />
    </ItemGroup>

</Project>
