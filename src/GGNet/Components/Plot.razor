@using GGNet.Buffers

@typeparam T
@typeparam TX
@typeparam TY

@inherits PlotBase<T, TX, TY>
@using static GGNet.Components.SvgFormat

<div class=@(CssClass()) theme=@Theme>
    <svg id=@Id xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox=@Attr($"0 0 {Width} {Height}")>

        <defs>
            @_renderLegendGradients
        </defs>

        <clipPath id="@(Id)-plot">
            <rect x="0" y="0" width=@Num(Width) height=@Num(Height) />
        </clipPath>

        <rect class="plot" width="100%" height="100%" />

        @_renderLegend

        <CascadingValue Value=@this IsFixed=true>
            @_renderPanels
        </CascadingValue>

    </svg>

    <div class="spinner">
        <svg viewBox="0 0 100 101">
            <path
                  class="track"
                  d="M100 50.5908C100 78.2051 77.6142 100.591 50 100.591C22.3858 100.591 0 78.2051 0 50.5908C0 22.9766 22.3858 0.59082 50 0.59082C77.6142 0.59082 100 22.9766 100 50.5908ZM9.08144 50.5908C9.08144 73.1895 27.4013 91.5094 50 91.5094C72.5987 91.5094 90.9186 73.1895 90.9186 50.5908C90.9186 27.9921 72.5987 9.67226 50 9.67226C27.4013 9.67226 9.08144 27.9921 9.08144 50.5908Z" />
            <path
                  class="accent"
                  d="M93.9676 39.0409C96.393 38.4038 97.8624 35.9116 97.0079 33.5539C95.2932 28.8227 92.871 24.3692 89.8167 20.348C85.8452 15.1192 80.8826 10.7238 75.2124 7.41289C69.5422 4.10194 63.2754 1.94025 56.7698 1.05124C51.7666 0.367541 46.6976 0.446843 41.7345 1.27873C39.2613 1.69328 37.813 4.19778 38.4501 6.62326C39.0873 9.04874 41.5694 10.4717 44.0505 10.1071C47.8511 9.54855 51.7191 9.52689 55.5402 10.0491C60.8642 10.7766 65.9928 12.5457 70.6331 15.2552C75.2735 17.9648 79.3347 21.5619 82.5849 25.841C84.9175 28.9121 86.7997 32.2913 88.1811 35.8758C89.083 38.2158 91.5421 39.6781 93.9676 39.0409Z" />
        </svg>
    </div>

</div>

@code {
    private void RenderLegendGradients(RenderTreeBuilder __builder)
    {
        for (int i = 0; i < Context.Legends.Count; i++)
        {
            var l = Context.Legends[i];
            if (l.Aes.Type != Guide.ColorBar)
            {
                continue;
            }

            var n = l.Items.Count;
            if (n < 2)
            {
                continue;
            }

            <linearGradient id="gadient-@(Id)-@i"
                            x1="0%"
                            y1="0%"
                            x2=@(Style.Legend.Direction == Direction.Vertical ? "0%" : "100%")
                            y2=@(Style.Legend.Direction == Direction.Vertical ? "100%" : "0%")>

                <stop offset="0%" stop-color=@l.Items[0].elements[0].Value.StopColor stop-opacity=@Num(l.Items[0].elements[0].Value.StopOpacity) />

                @if (n > 2)
                {
                    var delta = 100.0 / (n - 2.0);

                    for (var j = 0; j < n - 1; j++)
                    {
                        <stop offset=@Attr($"{j * delta}%") stop-color=@l.Items[j].elements[0].Value.StopColor stop-opacity=@Num(l.Items[j].elements[0].Value.StopOpacity) />
                    }
                }

                <stop offset="100%" stop-color=@l.Items[n - 1].elements[0].Value.StopColor stop-opacity=@Num(l.Items[n - 1].elements[0].Value.StopOpacity) />

            </linearGradient>
        }
    }

    private void RenderLegend(RenderTreeBuilder __builder)
    {
        if (Legend.Width == 0)
        {
            return;
        }

        if (Style.Legend.Direction == Direction.Vertical)
        {
            var offset = Legend.Y;

            for (int i = 0; i < Context.Legends.Count; i++)
            {
                var l = Context.Legends[i];

                if (l.Title?.Width > 0)
                {
                    offset += Style.Legend.Title.Margin.Top;

                    <text>
                        <text
                              class="legend-title"
                              x=@Num(Legend.X)
                              y=@Num(offset + l.Title.Height)
                              text-anchor=@(Style.Legend.Title.Anchor.Render())
                              font-size=@(Style.Legend.Title.FontSize)
                              clip-path="url(#@(Id)-plot)">
                            @l.Title.Value
                        </text>
                    </text>

                    offset += l.Title.Height + Style.Legend.Title.Margin.Bottom;
                }

                if (l.Aes.Type == Guide.Items)
                {
                    for (int j = 0; j < l.Items.Count; j++)
                    {
                        var (label, elements) = l.Items[j];

                        offset += Style.Legend.Labels.Margin.Top;

                        for (int k = 0; k < elements.Count; k++)
                        {
                            var element = elements[k];

                            if (element.Value is Elements.HLine hline)
                            {
                                <line x1=@Num(Legend.Y)
                                      x2=@Num(Legend.X + l.Width)
                                      y1=@Num(offset + elements.Height / 2.0)
                                      y2=@Num(offset + elements.Height / 2.0)
                                      stroke-width=@Num(hline.StrokeWidth)
                                      stroke=@hline.Stroke
                                      stroke-opacity=@Num(hline.StrokeOpacity)
                                      clip-path="url(#@(Id)-plot)" />

                            }
                            else if (element.Value is Elements.VLine vline)
                            {
                                <line x1=@Num(Legend.X + l.Width / 2.0)
                                      x2=@Num(Legend.X + l.Width / 2.0)
                                      y1=@Num(offset)
                                      y2=@Num(offset + elements.Height)
                                      stroke-width=@Num(vline.StrokeWidth)
                                      stroke=@vline.Stroke
                                      stroke-opacity=@Num(vline.StrokeOpacity)
                                      clip-path="url(#@(Id)-plot)" />

                            }
                            else if (element.Value is Elements.Circle circle)
                            {
                                <circle cx=@Num(Legend.X + l.Width / 2.0)
                                        cy=@Num(offset + elements.Height / 2.0)
                                        r=@Num(circle.Radius)
                                        stroke-width="0.71"
                                        stroke=@circle.Stroke
                                        stroke-opacity=@Num(circle.StrokeOpacity)
                                        fill=@circle.Fill
                                        fill-opacity=@Num(circle.FillOpacity)
                                        clip-path="url(#@(Id)-plot)" />
                            }
                            else if (element.Value is Elements.Rectangle rect)
                            {
                                <rect x=@Num(Legend.X)
                                      y=@Num(offset)
                                      width=@Num(l.Width)
                                      height=@Num(elements.Height)
                                      fill=@rect.Fill
                                      fill-opacity=@Num(rect.FillOpacity)
                                      stroke=@rect.Stroke
                                      stroke-width=@Num(rect.StrokeWidth)
                                      clip-path="url(#@(Id)-plot)" />
                            }
                        }

                        <text>
                            <text
                                  class="legend-label"
                                  x=@Num(Legend.X + l.Width + Style.Legend.Labels.Margin.Left)
                                  y=@Num(offset + elements.Height / 2.0 + label.Height / 4.0)
                                  text-anchor=@(Style.Legend.Labels.Anchor.Render())
                                  font-size=@(Style.Legend.Labels.FontSize)
                                  clip-path="url(#@(Id)-legend)">
                                @label.Value
                            </text>
                        </text>

                        offset += Math.Max(elements.Height, label.Height) + Style.Legend.Labels.Margin.Bottom;
                    }
                }
                else if (l.Aes.Type == Guide.ColorBar)
                {
                    var xOffset = Legend.X + l.Width + Style.Legend.Labels.Margin.Left;
                    offset += Style.Legend.Labels.Margin.Top;

                    var n = l.Items.Count;

                    for (int j = 0; j < n; j++)
                    {
                        var (label, _) = l.Items[j];

                        <text>
                            <text
                                  class="legend-label"
                                  x=@Num(xOffset)
                                  y=@Num(offset + (j + 1.0) * 3.0 * l.Height + label.Height / 4.0)
                                  text-anchor=@(Style.Legend.Labels.Anchor.Render())
                                  font-size=@(Style.Legend.Labels.FontSize)
                                  clip-path="url(#@(Id)-legend)">
                                @label.Value
                            </text>
                        </text>
                    }

                    <rect x=@Num(Legend.X)
                          y=@Num(offset)
                          width=@Num(l.Width)
                          height=@Num(3.0 * n * l.Height)
                          fill="url(#gadient-@(Id)-@i)"
                          stroke=@Style.Legend.Labels.Color
                          stroke-width="0.2"
                          clip-path="url(#@(Id)-plot)" />
                }
            }
        }
        else
        {
            var offset = Legend.X;
            var middle = Legend.Y + Legend.Height / 2.0;

            for (int i = 0; i < Context.Legends.Count; i++)
            {
                var l = Context.Legends[i];

                if (l.Title?.Height > 0)
                {
                    offset += Style.Legend.Title.Margin.Left;

                    <text>
                        <text
                              class="legend-title"
                              x=@Num(offset)
                              y=@Num(middle + l.Title.Height / 4.0)
                              text-anchor=@(Style.Legend.Title.Anchor.Render())
                              font-size=@(Style.Legend.Title.FontSize)
                              clip-path="url(#@(Id)-plot)">
                            @l.Title.Value
                        </text>
                    </text>

                    offset += l.Title.Width + Style.Legend.Title.Margin.Right;
                }

                if (l.Aes.Type == Guide.Items)
                {
                    for (int j = 0; j < l.Items.Count; j++)
                    {
                        var (label, elements) = l.Items[j];

                        for (int k = 0; k < elements.Count; k++)
                        {
                            var element = elements[k];

                            if (element.Value is Elements.HLine hline)
                            {
                                <line x1=@Num(offset)
                                      x2=@Num(offset + elements.Width)
                                      y1=@Num(middle)
                                      y2=@Num(middle)
                                      stroke-width=@Num(hline.StrokeWidth)
                                      stroke=@hline.Stroke
                                      stroke-opacity=@Num(hline.StrokeOpacity)
                                      stroke-dasharray=@(hline.LineType.Render())
                                      clip-path="url(#@(Id)-plot)" />

                            }
                            else if (element.Value is Elements.VLine vline)
                            {
                                <line x1=@Num(offset + elements.Width / 2.0)
                                      x2=@Num(offset + elements.Width / 2.0)
                                      y1=@Num(Legend.Y)
                                      y2=@Num(Legend.Y + Legend.Height)
                                      stroke-width=@Num(vline.StrokeWidth)
                                      stroke=@vline.Stroke
                                      stroke-opacity=@Num(vline.StrokeOpacity)
                                      stroke-dasharray=@(vline.LineType.Render())
                                      clip-path="url(#@(Id)-plot)" />

                            }
                            else if (element.Value is Elements.Circle circle)
                            {
                                <circle cx=@Num(offset + elements.Width / 2.0)
                                        cy=@Num(middle)
                                        r=@Num(circle.Radius)
                                        stroke-width="0.71"
                                        stroke=@circle.Stroke
                                        stroke-opacity=@Num(circle.StrokeOpacity)
                                        fill=@circle.Fill
                                        fill-opacity=@Num(circle.FillOpacity)
                                        clip-path="url(#@(Id)-plot)" />
                            }
                            else if (element.Value is Elements.Rectangle rect)
                            {
                                <rect x=@Num(offset)
                                      y=@Num(middle - elements.Height / 2.0)
                                      width=@Num(elements.Width)
                                      height=@Num(elements.Height)
                                      fill=@rect.Fill
                                      fill-opacity=@Num(rect.FillOpacity)
                                      stroke=@rect.StrokeOpacity
                                      stroke-width=@Num(rect.StrokeWidth)
                                      clip-path="url(#@(Id)-plot)" />
                            }
                        }

                        offset += elements.Width;

                        offset += Style.Legend.Labels.Margin.Left;

                        <text>
                            <text
                                  class="legend-label"
                                  x=@Num(offset)
                                  y=@Num(middle + label.Height / 4.0)
                                  text-anchor=@(Style.Legend.Labels.Anchor.Render())
                                  font-size=@(Style.Legend.Labels.FontSize)
                                  clip-path="url(#@(Id)-legend)">
                                @label.Value
                            </text>
                        </text>

                        offset += label.Width + Style.Legend.Labels.Margin.Right;
                    }
                }
                else if (l.Aes.Type == Guide.ColorBar)
                {
                    offset += Style.Legend.Labels.Margin.Left;

                    var yOffset = Legend.Y + l.Items[0].label.Height;

                    for (int j = 0; j < l.Items.Count; j++)
                    {
                        var (label, _) = l.Items[j];

                        <text>
                            <text
                                  class="legend-label"
                                  x=@Num(offset + 3.0 * (j + 1.0) * l.Width - label.Width / 2.0)
                                  y=@Num(yOffset)
                                  text-anchor=@(Style.Legend.Labels.Anchor.Render())
                                  font-size=@(Style.Legend.Labels.FontSize)
                                  clip-path="url(#@(Id)-legend)">
                                @label.Value
                            </text>
                        </text>
                    }

                    yOffset += Style.Legend.Labels.Margin.Bottom;

                    <rect x=@Num(offset)
                          y=@Num(yOffset)
                          width=@Num(3.0 * l.Width * l.Items.Count)
                          height=@Num(l.Height)
                          fill="url(#gadient-@(Id)-@i)"
                          stroke=@Style.Legend.Labels.Color
                          stroke-width="0.2"
                          clip-path="url(#@(Id)-plot)" />
                }
            }
        }
    }

    private void RenderPanels(RenderTreeBuilder __builder)
    {
        var panels = new (int row, int col, double width, double height)[Context.Panels.Count];

        for (var i = 0; i < Context.Panels.Count; i++)
        {
            var p = Context.Panels[i];

            panels[i] = (p.Coord.row, p.Coord.col, p.Width, p.Height);
        }

        var zones = Layout.PlotLayout.Subdivide(new(
            Wrapper: wrapper,
            N: Context.N,
            Strip: Context.Strip,
            Axis: Context.Axis,
            AxisVisibility: Context.AxisVisibility,
            AxisTitles: Context.AxisTitles,
            AxisTitlesVisibility: Context.AxisTitlesVisibility,
            HasXLab: !string.IsNullOrEmpty(Context.XLab),
            Style: Style), panels);

        for (var i = 0; i < Context.Panels.Count; i++)
        {
            var panel = Context.Panels[i];
            var zone = zones[i];

            <Panel Data=@panel
                   X=@zone.X
                   Y=@zone.Y
                   Width=@zone.Width
                   Height=@zone.Height
                   First=@(i == 0)
                   Last=@(i == (Context.Panels.Count - 1))
                   T=T TX=TX TY=TY />
        }
    }
}
