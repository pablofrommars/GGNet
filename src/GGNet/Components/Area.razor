@using GGNet.Scene

@typeparam T
@typeparam TX
@typeparam TY

@using static GGNet.Components.SvgFormat

@renderShapes

@code {
    private void RenderShapes(RenderTreeBuilder __builder)
    {
        var scene = ShapeComposer.Compose(Panel.Geoms, Coord, Zone);

        for (var i = 0; i < scene.Count; i++)
        {
            // Exhaustive over the ScreenPrimitive union (CS8509 is an error):
            // a primitive the walker cannot render is a compile failure.
            _ = scene[i] switch
            {
                ScreenCircle circle => RenderCircle(__builder, circle),
                ScreenLine line => RenderLine(__builder, line),
                ScreenRect rect => RenderRect(__builder, rect),
                ScreenFill fill => RenderFill(__builder, fill),
                ScreenStroke stroke => RenderStroke(__builder, stroke),
                ScreenPolygon polygon => RenderPolygon(__builder, polygon),
                ScreenRule rule => RenderRule(__builder, rule),
                ScreenText text => RenderText(__builder, text),
                ScreenLabel label => RenderLabel(__builder, label),
                ScreenAngledLabel angled => RenderAngledLabel(__builder, angled)
            };
        }
    }

    private bool RenderCircle(RenderTreeBuilder __builder, ScreenCircle circle)
    {
        <g transform=@Attr($"translate({circle.X}, {circle.Y})")>
            <circle
                    cx="0"
                    cy="0"
                    r=@Num(circle.Radius)
                    class=@circle.Css
                    stroke-width="0.71"
                    stroke=@circle.Fill
                    stroke-opacity=@Num(circle.StrokeOpacity)
                    fill=@circle.Fill
                    fill-opacity=@Num(circle.FillOpacity)
                    @onclick=@circle.OnClick
                    @onmouseover=@circle.OnMouseOver
                    @onmouseout=@circle.OnMouseOut />
        </g>

        return true;
    }

    private bool RenderLine(RenderTreeBuilder __builder, ScreenLine line)
    {
        <line x1=@Num(line.X1)
              y1=@Num(line.Y1)
              x2=@Num(line.X2)
              y2=@Num(line.Y2)
              class=@line.Css
              stroke-width=@Num(line.StrokeWidth)
              stroke=@line.Stroke
              stroke-opacity=@Num(line.StrokeOpacity)
              stroke-dasharray=@(line.LineType.Render())
              clip-path="url(#@(Clip))"
              @onclick=@line.OnClick
              @onmouseover=@line.OnMouseOver
              @onmouseout=@line.OnMouseOut />

        return true;
    }

    private bool RenderRect(RenderTreeBuilder __builder, ScreenRect rect)
    {
        <rect x=@Num(rect.X)
              y=@Num(rect.Y)
              width=@Num(rect.Width)
              height=@Num(rect.Height)
              class=@rect.Css
              fill=@rect.Fill
              fill-opacity=@Num(rect.FillOpacity)
              stroke=@rect.Stroke
              stroke-opacity=@Num(rect.StrokeOpacity)
              stroke-width=@Num(rect.StrokeWidth)
              clip-path="url(#@(Clip))"
              @onclick=@rect.OnClick
              @onmouseover=@rect.OnMouseOver
              @onmouseout=@rect.OnMouseOut />

        return true;
    }

    private bool RenderFill(RenderTreeBuilder __builder, ScreenFill fill)
    {
        <path d=@fill.D
              fill=@fill.Fill
              fill-opacity=@Num(fill.FillOpacity)
              clip-path="url(#@(Clip))" />

        return true;
    }

    private bool RenderStroke(RenderTreeBuilder __builder, ScreenStroke stroke)
    {
        <path d=@stroke.D
              fill="none"
              stroke-width=@Num(stroke.StrokeWidth)
              stroke=@stroke.Stroke
              stroke-opacity=@Num(stroke.StrokeOpacity)
              stroke-dasharray=@(stroke.LineType.Render())
              clip-path="url(#@(Clip))" />

        return true;
    }

    private bool RenderPolygon(RenderTreeBuilder __builder, ScreenPolygon polygon)
    {
        <path d=@polygon.D
              class=@polygon.Css
              fill=@polygon.Fill
              fill-opacity=@Num(polygon.FillOpacity)
              stroke=@polygon.Stroke
              stroke-width=@Num(polygon.StrokeWidth)
              clip-path="url(#@(Clip))"
              @onclick=@polygon.OnClick
              @onmouseover=@polygon.OnMouseOver
              @onmouseout=@polygon.OnMouseOut />

        return true;
    }

    private bool RenderRule(RenderTreeBuilder __builder, ScreenRule rule)
    {
        <line x1=@Num(rule.X1)
              y1=@Num(rule.Y1)
              x2=@Num(rule.X2)
              y2=@Num(rule.Y2)
              stroke-width=@Num(rule.StrokeWidth)
              stroke=@rule.Stroke
              stroke-opacity=@Num(rule.StrokeOpacity)
              stroke-dasharray=@(rule.LineType.Render())
              clip-path="url(#@(Clip))" />

        return true;
    }

    private bool RenderText(RenderTreeBuilder __builder, ScreenText text)
    {
        <text><text
                  class="pointer-events-none"
                  transform=@text.Transform
                  fill=@text.Fill
                  text-anchor=@text.Anchor
                  font-size=@text.FontSize
                  font-weight=@text.FontWeight
                  font-style=@text.FontStyle
                  clip-path="url(#@(Clip))">
                @text.Value
            </text></text>

        return true;
    }

    private bool RenderLabel(RenderTreeBuilder __builder, ScreenLabel label)
    {
        <text><text
                  class="pointer-events-none"
                  fill=@label.Fill
                  fill-opacity=@Num(label.FillOpacity)
                  text-anchor=@label.Anchor
                  font-size=@label.FontSize
                  font-weight=@label.FontWeight
                  font-style=@label.FontStyle
                  transform=@label.Transform
                  clip-path="url(#@(Clip))">
                @label.Value
            </text></text>

        return true;
    }

    private bool RenderAngledLabel(RenderTreeBuilder __builder, ScreenAngledLabel label)
    {
        <text><text
                  transform=@label.Transform
                  class="pointer-events-none"
                  fill=@label.Fill
                  fill-opacity=@Num(label.FillOpacity)
                  text-anchor=@label.Anchor
                  font-size=@label.FontSize
                  font-weight=@label.FontWeight
                  font-style=@label.FontStyle
                  clip-path="url(#@(Clip))">
                @label.Value
            </text></text>

        return true;
    }
}
