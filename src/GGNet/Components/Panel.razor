
@typeparam T
@typeparam TX
@typeparam TY
@using static GGNet.Components.SvgFormat

@{
    Render(firstRender);
    firstRender = false;
}

@if (First)
{
    @renderTitle
    @renderSubTitle
}

<defs>
    <clipPath id=@(clip)>
        <rect x=@Num(X) y=@Num(Y) width=@Num(Width) height=@Num(Height) />
    </clipPath>

    <clipPath id="@(clip)-area">
        <rect x=@Num(Area.X) y=@Num(Area.Y) width=@Num(Area.Width) height=@Num(Area.Height) />
    </clipPath>
</defs>

@if (Plot.Interactivity is null)
{
    @renderContent
}
else
{
    @* Gesture capture: bubbling catches wheel/dblclick over any child (marks
       included) without suppressing the per-mark handlers. Emitted only under
       the opt-in — non-interactive plots keep today's flat structure. *@
    @* Wheel is captured by the JS module (fresh client-rect per event, so the
       responsive svg's scale is always exact); discrete events stay Blazor's. *@
    <g @ref=captureRef @ondblclick=OnResetViewAsync @onmouseleave=OnCrosshairLeave>
        @renderContent
    </g>
}

@renderXLab
@renderYLab

@if (Last)
{
    @renderCaption
}

<Tooltip Coord=@this Zone=@Area Glued=@(Plot.Interactivity is { CursorTooltip: true }) GlueAsync=@GlueTooltipAsync @ref=@tooltipComponent />

@code {

    // The panel's gesture-capturable content: background, strips, grid, marks.
    // One fragment so the opt-in wrapper and the flat default emit the same bytes.
    private void RenderContent(RenderTreeBuilder __builder)
    {
        <rect
        class="panel"
        @onclick=OnClick
        x=@Num(Area.X)
        y=@Num(Area.Y)
        width=@Num(Area.Width)
        height=@Num(Area.Height) />

        @renderStrip

        @renderGrid

        @if (Plot.Interactivity is { Crosshair: true } && coord.CarvesAxisBands)
        {
            @* Invisible hover strips under the marks: the Tier-0 crosshair
               samples the pointer without continuous mousemove tracking.
               Cartesian only — polar has no invertible x band. *@
            var count = (int)(Area.Width / 8.0);

            if (count > 0)
            {
                var stride = Area.Width / count;

                for (var i = 0; i < count; i++)
                {
                    var center = Area.X + (i + 0.5) * stride;

                    <rect x=@Num(Area.X + i * stride)
                          y=@Num(Area.Y)
                          width=@Num(stride)
                          height=@Num(Area.Height)
                          fill="none"
                          pointer-events="all"
                          @onmouseover=@(() => OnCrosshairOver(center)) />
                }
            }
        }

        @if (Plot.Interactivity is null)
        {
            <Area T=T TX=TX TY=TY Panel=@Data Coord=@this Zone=@Area Clip=@(clip + "-area") RenderModeHandler=@areaRenderModeHandler />
        }
        else
        {
            @* The marks-only transform target: the drag preview translates this
               group client-side; the capture group above stays the event surface. *@
            <g @ref=panRef>
                <Area T=T TX=TX TY=TY Panel=@Data Coord=@this Zone=@Area Clip=@(clip + "-area") RenderModeHandler=@areaRenderModeHandler />
            </g>
        }

        @if (crosshair is { } cross)
        {
            <line class="crosshair pointer-events-none"
                  x1=@Num(cross.x)
                  x2=@Num(cross.x)
                  y1=@Num(Area.Y)
                  y2=@Num(Area.Y + Area.Height)
                  clip-path="url(#@(clip)-area)" />

            @if (cross.label is not null)
            {
                <text><text
                          class="crosshair-label pointer-events-none"
                          x=@Num(cross.x)
                          y=@Num(Area.Y + 14.0)
                          text-anchor="middle"
                          font-size=@(Plot.Style.Axis.Text.X.FontSize)
                          clip-path="url(#@(clip)-area)">
                        @cross.label
                    </text></text>
            }
        }
    }

    private void RenderTitle(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.Title))
        {
            return;
        }

        <text><text
            class="title"
            x=@Num(Plot.Title.X + Area.X)
            y=@Num(Plot.Title.Y)
            font-size=@(Plot.Style.Plot.Title.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.Title)
        </text></text>
    }

    private void RenderSubTitle(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.SubTitle))
        {
            return;
        }

        <text><text
            class="sub-title"
            x=@Num(Plot.SubTitle.X + Area.X)
            y=@Num(Plot.SubTitle.Y)
            font-size=@(Plot.Style.Plot.SubTitle.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.SubTitle)
        </text></text>
    }

    private void RenderStrip(RenderTreeBuilder __builder)
    {
        if (Data.Strip.x is not null)
        {
            <text><text
                class="x-strip"
                x=@Num(xStrip.X)
                y=@Num(xStrip.Y)
                text-anchor=@(Plot.Style.Strip.Text.X.Anchor.Render())
                font-size=@(Plot.Style.Strip.Text.X.FontSize)
                clip-path="url(#@(Plot.Id)-plot)">
                @Data.Strip.x
            </text></text>
        }

        if (Data.Strip.y is not null)
        {
            <text><text
                class="y-strip"
                transform=@Attr($"translate({yStrip.X}, {yStrip.Y}) rotate({Plot.Style.Strip.Text.Y.Angle}deg)")
                text-anchor=@(Plot.Style.Strip.Text.Y.Anchor.Render())
                font-size=@(Plot.Style.Strip.Text.Y.FontSize)
                clip-path="url(#@(Plot.Id)-plot)">
                @Data.Strip.y
            </text></text>
        }
    }

    private void RenderGrid(RenderTreeBuilder __builder)
    {
        foreach (var line in grid.XLines)
        {
            <line
            class=@line.Class
            x1=@Num(line.X1)
            x2=@Num(line.X2)
            y1=@Num(line.Y1)
            y2=@Num(line.Y2)
            clip-path="url(#@(clip)-area)" />
        }

        foreach (var ring in grid.Rings)
        {
            <circle
            class=@ring.Class
            fill="none"
            cx=@Num(ring.CenterX)
            cy=@Num(ring.CenterY)
            r=@Num(ring.Radius)
            clip-path="url(#@(clip)-area)" />
        }

        foreach (var path in grid.RingPaths)
        {
            <path
            class=@path.Class
            fill="none"
            d=@RingPath(path.Points)
            clip-path="url(#@(clip)-area)" />
        }

        @foreach (var label in grid.XLabels)
        {
            RenderGridLabel(__builder, label);
        }

        foreach (var line in grid.YLines)
        {
            <line
            class=@line.Class
            x1=@Num(line.X1)
            x2=@Num(line.X2)
            y1=@Num(line.Y1)
            y2=@Num(line.Y2)
            clip-path="url(#@(clip)-area)" />
        }

        @foreach (var label in grid.YLabels)
        {
            RenderGridLabel(__builder, label);
        }
    }

    private void RenderGridLabel(RenderTreeBuilder __builder, Coords.GridLabel label)
    {
        <text>
            <text
                class=@label.Class
                x=@Num(label.X)
                y=@Num(label.Y)
                text-anchor=@label.Anchor
                font-size=@label.FontSize
                clip-path="url(#@(GridClipId(label.Clip)))">
                @label.Text
            </text>
        </text>
    }

    private void RenderCaption(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.Caption))
        {
            return;
        }

        <text><text
            class="caption"
            x=@Num(Area.X + Area.Width - Plot.Style.Plot.Caption.Margin.Right)
            y=@Num(Plot.Caption.Y)
            font-size=@(Plot.Style.Plot.Caption.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.Caption)
        </text></text>
    }

    private void RenderXLab(RenderTreeBuilder __builder)
    {
        if (!coord.CarvesAxisBands || string.IsNullOrEmpty(Data.XLab.text))
        {
            return;
        }

        <text><text
            class="x-title"
            x=@Num(xAxisTitle.X)
            y=@Num(xAxisTitle.Y)
            text-anchor=@(Plot.Style.Axis.Title.X.Anchor.Render())
            font-size=@(Plot.Style.Axis.Title.X.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Data.XLab.text)
        </text></text>
    }

    private void RenderYLab(RenderTreeBuilder __builder)
    {
        if (!coord.CarvesAxisBands || string.IsNullOrEmpty(Data.YLab.text))
        {
            return;
        }

        <text><text
            class="y-title"
            x="0"
            y="0"
            transform=@Attr($"rotate({Plot.Style.Axis.Title.Y.Angle}) translate({-yAxisTitle.Y}, {yAxisTitle.X})")
            text-anchor=@(Plot.Style.Axis.Title.Y.Anchor.Render())
            font-size=@(Plot.Style.Axis.Title.Y.FontSize)>
            @((MarkupString)Data.YLab.text)
        </text></text>
    }
}