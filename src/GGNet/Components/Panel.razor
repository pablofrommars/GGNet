@using GGNet.Buffers

@typeparam T
@typeparam TX
@typeparam TY

@{
    Render(firstRender);
    firstRender = false;
}

@if (First)
{
    @_renderTitle
    @_renderSubTitle
}

<defs>
    <clipPath id=@(clip)>
        <rect x=@X y=@Y width=@Width height=@Height />
    </clipPath>

    <clipPath id="@(clip)-area">
        <rect x=@Area.X y=@Area.Y width=@Area.Width height=@Area.Height />
    </clipPath>
</defs>

<rect
class="panel"
@onclick=OnClick
x=@Area.X
y=@Area.Y
width=@Area.Width
height=@Area.Height />

@_renderStrip

@_renderGrid

<Area T=T TX=TX TY=TY Panel=@Data Coord=@this Zone=@Area Clip=@(clip + "-area") RenderModeHandler=@areaRenderModeHandler />

@_renderXLab
@_renderYLab

@if (Last)
{
    @_renderCaption
}

<Tooltip Coord=@this Zone=@Area @ref=@tooltipComponent />

@code {

    private void RenderTitle(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.Title))
        {
            return;
        }

        <text><text
            class="title"
            x=@(Plot.Title.X + Area.X)
            y=@(Plot.Title.Y)
            font-size=@(Plot.Style.Plot.Title.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.Title)
        </text></text>
    }

    private void RenderSubTitle(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.SubTitle))
        {
            return;
        }

        <text><text
            class="sub-title"
            x=@(Plot.SubTitle.X + Area.X)
            y=@Plot.SubTitle.Y
            font-size=@(Plot.Style.Plot.SubTitle.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.SubTitle)
        </text></text>
    }

    private void RenderStrip(RenderTreeBuilder __builder)
    {
        if (Data.Strip.x is not null)
        {
            <text><text
                class="x-strip"
                x=@(xStrip.X)
                y=@(xStrip.Y)
                text-anchor=@(Plot.Style.Strip.Text.X.Anchor.Render())
                font-size=@(Plot.Style.Strip.Text.X.FontSize)
                clip-path="url(#@(Plot.Id)-plot)">
                @Data.Strip.x
            </text></text>
        }



        if (Data.Strip.y is not null)
        {
            <text><text
                class="y-strip"
                transform="translate(@(yStrip.X), @(yStrip.Y)) rotate(@(Plot.Style.Strip.Text.Y.Angle)deg)"
                text-anchor=@(Plot.Style.Strip.Text.Y.Anchor.Render())
                font-size=@(Plot.Style.Strip.Text.Y.FontSize)
                clip-path="url(#@(Plot.Id)-plot)">
                @Data.Strip.y
            </text></text>
        }
    }

    private void RenderGrid(RenderTreeBuilder __builder)
    {
        if (polar)
        {
            RenderPolarGrid(__builder);

            return;
        }

        var y1 = Area.Y;
        var y2 = Area.Y + Area.Height;

        foreach (var b in xscale.Breaks)
        {
            var x = ToX(b);
            <line
            class="x-break"
            x1=@x
            x2=@x
            y1=@y1
            y2=@y2
            clip-path="url(#@(clip)-area)" />
        }

        foreach (var b in xscale.MinorBreaks)
        {
            var x = ToX(b);
            <line
            class="x-minor-break"
            x1=@x
            x2=@x
            y1=@y1
            y2=@y2
            clip-path="url(#@(clip)-area)" />
        }

        if (Data.Axis.x)
        {
            @foreach (var (value, label) in xscale.Labels)
            {
                var x = ToX(value);

                if (Area.X < x && x < (Area.X + Area.Width))
                {
                    <text>
                        <text
                            class="x-break-label"
                            x=@x
                            y=@(xAxisText.Y)
                            text-anchor=@(Plot.Style.Axis.Text.X.Anchor.Render())
                            font-size=@(Plot.Style.Axis.Text.X.FontSize)
                            clip-path="url(#@(Plot.Id)-plot)">
                            @label
                        </text>
                    </text>
                }
            }

            @foreach (var (value, label) in xscale.Titles)
            {
                var x = ToX(value);

                if (Area.X < x && x < (Area.X + Area.Width))
                {
                    <text>
                        <text
                            class="x-break-title"
                            x=@x
                            y=@(xAxisTitle.Y)
                            text-anchor="middle"
                            font-size=@(Plot.Style.Axis.Title.X.FontSize)
                            clip-path="url(#@(Plot.Id)-plot)">
                            @label
                        </text>
                    </text>
                }
            }
        }

        var x1 = Area.X;
        var x2 = Area.X + Area.Width;

        foreach (var b in yscale.Breaks)
        {
            var y = ToY(b);
            <line
            class="y-break"
            x1=@x1
            x2=@x2
            y1=@y
            y2=@y
            clip-path="url(#@(clip)-area)" />
        }

        foreach (var b in yscale.MinorBreaks)
        {
            var y = ToY(b);
            <line
            class="y-minor-break"
            x1=@x1
            x2=@x2
            y1=@y
            y2=@y
            clip-path="url(#@(clip)-area)" />
        }

        if (Data.Axis.y)
        {
            var height = Data.Data.Style!.Axis.Text.Y.FontSize.Height();
            var offset = height / 4.0;

            @foreach (var (value, label) in yscale.Labels)
            {
                var y = ToY(value) + offset;

                if (Area.Y < (y - height / 2.0) && (y + offset) < (Area.Y + Area.Height))
                {
                    <text>
                        <text
                            class="y-break-label"
                            x=@(yAxisText.X)
                            y=@y
                            text-anchor=@(Plot.Style.Axis.Text.Y.Anchor.Render())
                            font-size=@(Plot.Style.Axis.Text.Y.FontSize)
                            clip-path="url(#@(clip))">
                            @label
                        </text>
                    </text>
                }
            }
        }
    }

    private void RenderPolarGrid(RenderTreeBuilder __builder)
    {
        var spokes = xscale.Breaks.Select(b => xscale.Coord(b)).ToArray();
        var web = Plot.Style.Polar.Rings == PolarRingType.Polygon && spokes.Length >= 3;

        foreach (var f in spokes)
        {
            var (px, py) = ProjectFraction(f, 1.0);

            <line
            class="x-break"
            x1=@centerX
            x2=@px
            y1=@centerY
            y2=@py
            clip-path="url(#@(clip)-area)" />
        }

        foreach (var b in yscale.Breaks)
        {
            var f = yscale.Coord(b);

            if (f < 0.0 || f > 1.0)
            {
                continue;
            }

            if (web)
            {
                <path
                class="y-break"
                fill="none"
                d=@PolarRingPath(spokes, f)
                clip-path="url(#@(clip)-area)" />
            }
            else
            {
                <circle
                class="y-break"
                fill="none"
                cx=@centerX
                cy=@centerY
                r=@(f * radius)
                clip-path="url(#@(clip)-area)" />
            }
        }

        foreach (var b in yscale.MinorBreaks)
        {
            var f = yscale.Coord(b);

            if (f < 0.0 || f > 1.0)
            {
                continue;
            }

            if (web)
            {
                <path
                class="y-minor-break"
                fill="none"
                d=@PolarRingPath(spokes, f)
                clip-path="url(#@(clip)-area)" />
            }
            else
            {
                <circle
                class="y-minor-break"
                fill="none"
                cx=@centerX
                cy=@centerY
                r=@(f * radius)
                clip-path="url(#@(clip)-area)" />
            }
        }

        var fontHeight = Plot.Style.Axis.Text.X.FontSize.Height();
        var labelRadius = radius + Plot.Style.Polar.LabelMargin;

        @foreach (var (value, label) in xscale.Labels)
        {
            var theta = GGNet.Coords.Polar.Angle(xscale.Coord(value), Data.Data.PolarOptions.StartAngle, Data.Data.PolarOptions.Clockwise);

            var cos = Math.Cos(theta);
            var sin = Math.Sin(theta);

            var x = centerX + labelRadius * cos;
            var y = centerY + labelRadius * sin + (sin + 1.0) / 2.0 * fontHeight * 0.8;

            var anchor = cos < -0.1 ? "end" : cos > 0.1 ? "start" : "middle";

            <text>
                <text
                    class="x-break-label"
                    x=@x
                    y=@y
                    text-anchor=@anchor
                    font-size=@(Plot.Style.Axis.Text.X.FontSize)
                    clip-path="url(#@(clip))">
                    @label
                </text>
            </text>
        }

        @foreach (var (value, label) in yscale.Labels)
        {
            var f = yscale.Coord(value);

            if (f < 0.0 || f > 1.0)
            {
                continue;
            }

            var (px, py) = ProjectFraction(0.0, f);

            <text>
                <text
                    class="y-break-label"
                    x=@(px + 4)
                    y=@(py - 2)
                    text-anchor="start"
                    font-size=@(Plot.Style.Axis.Text.Y.FontSize)
                    clip-path="url(#@(clip))">
                    @label
                </text>
            </text>
        }
    }

    private void RenderCaption(RenderTreeBuilder __builder)
    {
        if (string.IsNullOrEmpty(Plot.Context.Caption))
        {
            return;
        }

        <text><text
            class="caption"
            x=@(Area.X + Area.Width - Plot.Style.Plot.Caption.Margin.Right)
            y=@(Plot.Caption.Y)
            font-size=@(Plot.Style.Plot.Caption.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Plot.Context.Caption)
        </text></text>
    }

    private void RenderXLab(RenderTreeBuilder __builder)
    {
        if (polar || string.IsNullOrEmpty(Data.XLab.text))
        {
            return;
        }

        <text><text
            class="x-title"
            x=@(xAxisTitle.X)
            y=@(xAxisTitle.Y)
            text-anchor=@(Plot.Style.Axis.Title.X.Anchor.Render())
            font-size=@(Plot.Style.Axis.Title.X.FontSize)
            clip-path="url(#@(Plot.Id)-plot)">
            @((MarkupString)Data.XLab.text)
        </text></text>
    }

    private void RenderYLab(RenderTreeBuilder __builder)
    {
        if (polar || string.IsNullOrEmpty(Data.YLab.text))
        {
            return;
        }

        <text><text
            class="y-title"
            x="0"
            y="0"
            transform="rotate(@(Plot.Style.Axis.Title.Y.Angle)) translate(-@(yAxisTitle.Y), @(yAxisTitle.X))"
            text-anchor=@(Plot.Style.Axis.Title.Y.Anchor.Render())
            font-size=@(Plot.Style.Axis.Title.Y.FontSize)>
            @((MarkupString)Data.YLab.text)
        </text></text>
    }
}