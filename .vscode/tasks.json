{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build GGNet",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/GGNet/GGNet.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build GGNet.Static",
			"command": "dotnet",
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/GGNet.Static/GGNet.Static.csproj"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "build all",
			"dependsOn": [
				"build GGNet",
				"build GGNet.Static"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "pack GGNet",
			"command": "dotnet",
			"type": "process",
			"args": [
				"pack",
				"--configuration",
				"release",
				"--output",
				"${workspaceFolder}/packages",
				"${workspaceFolder}/src/GGNet/GGNet.csproj"
			],
			"problemMatcher": "$msCompile",
			"presentation": {
				"echo": true,
				"revealProblems": "onProblem",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false,
				"close": true
			}
		},
		{
			"label": "pack GGNet.Static",
			"command": "dotnet",
			"type": "process",
			"args": [
				"pack",
				"--configuration",
				"release",
				"--output",
				"${workspaceFolder}/packages",
				"${workspaceFolder}/src/GGNet.Static/GGNet.Static.csproj"
			],
			"problemMatcher": "$msCompile",
			"presentation": {
				"echo": true,
				"revealProblems": "onProblem",
				"focus": false,
				"panel": "dedicated",
				"showReuseMessage": true,
				"clear": false,
				"close": true
			}
		},
		{
			"label": "pack all",
			"dependsOn": [
				"pack GGNet",
				"pack GGNet.Static"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "nuget push",
			"command": "dotnet",
			"type": "process",
			"args": [
				"nuget",
				"push",
				"${input:package}",
				"--skip-duplicate",
				"--api-key",
				"${env:NUGET_API_KEY}",
				"--source",
				"https://api.nuget.org/v3/index.json"
			],
			"options": {
				"cwd": "packages"
			},
			"problemMatcher": "$msCompile"
		},
		{
			"label": "ggnet-git: status",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"status"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: doctor",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"doctor"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: start agent task",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"agent-start",
				"${input:branchName}"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: cleanup task (dry run)",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"cleanup"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: refresh from parent",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"refresh"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: squash task commits",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"squash"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		},
		{
			"label": "ggnet-git: merge directly to main",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/scripts/git-flow.sh",
			"args": [
				"merge"
			],
			"presentation": {
				"reveal": "always",
				"panel": "dedicated"
			},
			"problemMatcher": []
		}
	],
	"inputs": [
		{
			"id": "package",
			"type": "promptString",
			"description": "Package file(s)",
			"default": "*.nupkg"
		},
		{
			"id": "branchName",
			"type": "promptString",
			"description": "Branch name (e.g. ABC-123-add-widget)"
		}
	]
}
