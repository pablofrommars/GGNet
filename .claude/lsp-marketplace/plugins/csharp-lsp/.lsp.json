{
	"csharp": {
		"command": "ClaudeCodeRoslynLspProxy",
		"args": [
			"--server",
			"roslyn-language-server",
			"--",
			"--stdio",
			"--autoLoadProjects"
		],
		"extensionToLanguage": {
			".cs": "csharp",
			".razor": "aspnetcorerazor",
			".cshtml": "aspnetcorerazor"
		},
		"startupTimeout": 120000
	}
}
