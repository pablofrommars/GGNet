{
	"permissions": {
		"allow": [
			"Bash(dotnet build:*)",
			"Bash(dotnet run:*)",
			"Bash(dotnet test:*)",
			"Bash(dotnet restore:*)",
			"Bash(dotnet clean:*)",
			"Bash(dotnet format:*)",
			"Bash(dotnet list:*)",
			"Bash(dotnet sln:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(ls:*)",
			"Bash(cat:*)",
			"Bash(rg:*)",
			"Bash(grep:*)",
			"Bash(find:*)",
			"Bash(tree:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(wc:*)",
			"Bash(pwd)",
			"Bash(which:*)",
			"Bash(diff:*)",
			"Bash(sed:*)",
			"Bash(awk:*)",
			"Bash(jq:*)",
			"Bash(yq:*)",
			"Read(**)",
			"Edit(**)",
			"Grep(**)"
		],
		"deny": [
			"Bash(sudo:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(dotnet nuget delete:*)",
			"Bash(rm -rf:*)",
			"Bash(rm -fr:*)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/secrets.json)",
			"Read(**/.aws/credentials)",
			"Read(**/.azure/**)",
			"Read(**/id_rsa)",
			"Read(**/id_ed25519)",
			"Read(**/*.pfx)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Edit(.git/**)"
		],
		"ask": [
			"Bash(dotnet new:*)",
			"Bash(dotnet add:*)",
			"Bash(dotnet remove:*)",
			"Bash(dotnet tool:*)",
			"Bash(dotnet pack:*)",
			"Bash(dotnet ef:*)",
			"Bash(dotnet watch:*)",
			"Bash(dotnet user-secrets:*)",
			"Bash(dotnet workload:*)",
			"Bash(dotnet nuget push:*)",
			"Bash(dotnet publish:*)",
			"Bash(git branch:*)",
			"Bash(git remote:*)",
			"Bash(git checkout:*)",
			"Bash(git switch:*)",
			"Bash(git add:*)",
			"Bash(git commit:*)",
			"Bash(git stash:*)",
			"Bash(git restore:*)",
			"Bash(git fetch:*)",
			"Bash(git pull:*)",
			"Bash(git rebase:*)",
			"Bash(git merge:*)",
			"Bash(git cherry-pick:*)",
			"Bash(git tag:*)",
			"Bash(git push:*)",
			"Bash(git clean:*)",
			"Bash(gh pr:*)",
			"Bash(gh issue:*)",
			"Bash(gh repo:*)",
			"Bash(gh run:*)",
			"Bash(gh workflow:*)",
			"Bash(gh release:*)",
			"Bash(mkdir:*)",
			"Bash(touch:*)",
			"Bash(cp:*)",
			"Bash(mv:*)",
			"Bash(rm:*)",
			"Bash(npm:*)",
			"Bash(npx:*)",
			"Bash(pnpm:*)",
			"Bash(node:*)",
			"Bash(curl:*)",
			"Bash(http:*)",
			"Bash(brew:*)",
			"Bash(podman:*)",
			"Bash(docker:*)",
			"Bash(az:*)",
			"Bash(aws:*)",
			"Bash(kubectl:*)",
			"Bash(terraform:*)",
			"Edit(.env*)",
			"Edit(**/appsettings.Production.json)",
			"Edit(**/*.pubxml)",
			"WebFetch(domain:learn.microsoft.com)",
			"WebFetch(domain:docs.microsoft.com)",
			"WebFetch(domain:devblogs.microsoft.com)",
			"WebFetch(domain:nuget.org)",
			"WebFetch(domain:www.nuget.org)",
			"WebFetch(domain:github.com)",
			"WebFetch(domain:raw.githubusercontent.com)",
			"WebFetch(domain:stackoverflow.com)",
			"WebFetch(domain:dotnet.microsoft.com)",
			"WebFetch(domain:www.data-to-viz.com)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/guide.sh\" claude",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/format.sh\" claude --solution GGNet.slnx",
						"timeout": 120,
						"statusMessage": "Verifying whitespace formatting..."
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/session.sh\" notify claude",
						"timeout": 5
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"csharp-lsp@ggnet-lsp": true
	},
	"extraKnownMarketplaces": {
		"ggnet-lsp": {
			"source": {
				"source": "directory",
				"path": "./.claude/lsp-marketplace"
			}
		}
	},
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": true,
		"autoAllowBashIfSandboxed": false,
		"allowUnsandboxedCommands": true,
		"network": {
			"allowedDomains": [
				"github.com",
				"api.github.com",
				"codeload.github.com",
				"raw.githubusercontent.com",
				"objects.githubusercontent.com",
				"*.nuget.org",
				"api.nuget.org",
				"www.nuget.org",
				"dotnet.microsoft.com",
				"learn.microsoft.com",
				"builds.dotnet.microsoft.com",
				"aka.ms",
				"*.azureedge.net",
				"pkgs.dev.azure.com",
				"registry.npmjs.org",
				"*.npmjs.org",
				"www.data-to-viz.com"
			],
			"allowLocalBinding": true
		},
		"filesystem": {
			"allowWrite": [
				"./",
				"/tmp",
				"~/.nuget",
				"~/.dotnet",
				"~/.local/share/NuGet"
			],
			"denyRead": [
				"~/.ssh",
				"~/.aws",
				"~/.azure",
				"~/.gnupg",
				"~/.config/gh"
			]
		},
		"excludedCommands": [
			"brew *",
			"docker *",
			"podman *",
			"az *",
			"aws *",
			"kubectl *",
			"terraform *",
			"dotnet *"
		]
	}
}
