{
	"permissions": {
		"allow": [
			"Bash(dotnet build:*)",
			"Bash(dotnet run:*)",
			"Bash(dotnet test:*)",
			"Bash(dotnet restore:*)",
			"Bash(dotnet clean:*)",
			"Bash(dotnet format:*)",
			"Bash(dotnet list:*)",
			"Bash(dotnet sln:*)",
			"Bash(git status:*)",
			"Bash(git diff:*)",
			"Bash(git log:*)",
			"Bash(git show:*)",
			"Bash(ls:*)",
			"Bash(cat:*)",
			"Bash(rg:*)",
			"Bash(grep:*)",
			"Bash(find:*)",
			"Bash(tree:*)",
			"Bash(head:*)",
			"Bash(tail:*)",
			"Bash(wc:*)",
			"Bash(pwd)",
			"Bash(which:*)",
			"Bash(diff:*)",
			"Bash(sed:*)",
			"Bash(awk:*)",
			"Bash(jq:*)",
			"Bash(yq:*)",
			"Read(**)",
			"Edit(**)",
			"Grep(**)"
		],
		"deny": [
			"Bash(sudo:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git reset --hard:*)",
			"Bash(dotnet nuget delete:*)",
			"Bash(rm -rf:*)",
			"Bash(rm -fr:*)",
			"Read(.env)",
			"Read(.env.*)",
			"Read(**/secrets.json)",
			"Read(**/.aws/credentials)",
			"Read(**/.azure/**)",
			"Read(**/id_rsa)",
			"Read(**/id_ed25519)",
			"Read(**/*.pfx)",
			"Read(**/*.pem)",
			"Read(**/*.key)",
			"Edit(.git/**)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Edit|MultiEdit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/guide.sh\" claude",
						"timeout": 5
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/format.sh\" claude --solution GGNet.slnx",
						"timeout": 120,
						"statusMessage": "Verifying whitespace formatting..."
					}
				]
			},
			{
				"hooks": [
					{
						"type": "command",
						"command": "bash \"$CLAUDE_PROJECT_DIR/agent/hooks/session.sh\" notify claude",
						"timeout": 5
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"csharp-lsp@ggnet-lsp": true
	},
	"extraKnownMarketplaces": {
		"ggnet-lsp": {
			"source": {
				"source": "directory",
				"path": "./.claude/lsp-marketplace"
			}
		}
	},
	"sandbox": {
		"enabled": true,
		"failIfUnavailable": true,
		"autoAllowBashIfSandboxed": true,
		"allowUnsandboxedCommands": true,
		"network": {
			"allowedDomains": [
				"github.com",
				"api.github.com",
				"codeload.github.com",
				"raw.githubusercontent.com",
				"objects.githubusercontent.com",
				"*.nuget.org",
				"api.nuget.org",
				"www.nuget.org",
				"dotnet.microsoft.com",
				"learn.microsoft.com",
				"builds.dotnet.microsoft.com",
				"aka.ms",
				"*.azureedge.net",
				"pkgs.dev.azure.com",
				"registry.npmjs.org",
				"*.npmjs.org",
				"www.data-to-viz.com"
			],
			"allowLocalBinding": true
		},
		"filesystem": {
			"allowWrite": [
				"./",
				"/tmp",
				"~/.nuget",
				"~/.dotnet",
				"~/.local/share/NuGet"
			],
			"denyRead": [
				"~/.ssh",
				"~/.aws",
				"~/.azure",
				"~/.gnupg",
				"~/.config/gh"
			]
		},
		"excludedCommands": [
			"brew *",
			"docker *",
			"podman *",
			"az *",
			"aws *",
			"kubectl *",
			"terraform *",
			"dotnet *"
		]
	}
}
