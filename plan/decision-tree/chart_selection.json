{
  "schema_version": 4,
  "axes": {
    "function": ["comparison", "correlation", "distribution", "part_to_whole", "trend_over_time"],
    "num_vars": ["0", "1", "2", "3", "many"],
    "cat_vars": ["0", "1", "2", "many"],
    "cat_structure": ["none", "flat", "subgroup", "nested"],
    "obs_per_group": ["one", "many"],
    "ordered_num": [true, false],
    "is_relational": [true, false],
    "is_spatial": [true, false],
    "physical_subject": [true, false],
    "cardinality": ["low_2_7", "medium_8_20", "high_gt_20"],
    "metric_type": ["count", "rate", "amount", "score"],
    "spatial_grain": ["region", "point", "flow"],
    "distribution_shape": ["normal", "skewed", "bimodal", "power_law", "uniform", "unknown"]
  },
  "story_need_aliases": {
    "sequence_causality": "trend_over_time",
    "change_over_time": "trend_over_time",
    "geography_impact": "comparison",
    "distribution_inequality": "distribution",
    "network_system": "correlation",
    "comparison_ranking": "comparison",
    "physical_how_things_work": "part_to_whole",
    "part_of_whole": "part_to_whole",
    "relationship": "correlation"
  },
  "leaves": [
    {"id": "barplot", "functions": ["comparison", "part_to_whole"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false},
    {"id": "lollipop", "functions": ["comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false},
    {"id": "dot_plot", "functions": ["comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "caveats": ["Preferred over bars when axis does not start at zero"]},
    {"id": "dumbbell", "functions": ["comparison", "trend_over_time"], "num_vars": "2", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "caveats": ["Two values per category (before/after, A/B)"]},
    {"id": "table", "functions": ["comparison"], "num_vars": "many", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["low_2_7", "medium_8_20"]},
      "caveats": ["Often the correct answer when exact values matter more than pattern"]},
    {"id": "grouped_barplot", "functions": ["comparison"], "num_vars": "1", "cat_vars": "2", "cat_structure": "subgroup", "obs_per_group": "one", "ordered_num": false},
    {"id": "stacked_barplot", "functions": ["comparison", "part_to_whole"], "num_vars": "1", "cat_vars": "2", "cat_structure": "subgroup", "obs_per_group": "one", "ordered_num": false},
    {"id": "small_multiples", "functions": ["comparison", "trend_over_time", "distribution"], "cat_vars": "2", "cat_structure": "subgroup",
      "caveats": ["Escape hatch when a single chart is overloaded: one panel per category"]},
    {"id": "radar", "functions": ["comparison"], "num_vars": "many", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["low_2_7"]},
      "caveats": ["Weak beyond ~8 axes; consider parallel_plot"]},
    {"id": "parallel_plot", "functions": ["comparison", "correlation"], "num_vars": "many", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false},
    {"id": "heatmap", "functions": ["comparison", "correlation"], "num_vars": "1", "cat_vars": "2", "cat_structure": "subgroup", "obs_per_group": "one", "ordered_num": false},
    {"id": "wordcloud", "functions": ["comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["medium_8_20", "high_gt_20"]},
      "caveats": ["Imprecise encoding; decorative use only"]},

    {"id": "scatter", "functions": ["correlation"], "num_vars": "2", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},
    {"id": "grouped_scatter", "functions": ["correlation"], "num_vars": "2", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "many", "ordered_num": false},
    {"id": "bubble", "functions": ["correlation"], "num_vars": "3", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false,
      "caveats": ["Encode third variable by AREA, never radius"]},
    {"id": "density_2d", "functions": ["correlation", "distribution"], "num_vars": "2", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},
    {"id": "correlogram", "functions": ["correlation"], "num_vars": "many", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},
    {"id": "pca", "functions": ["correlation"], "num_vars": "many", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},

    {"id": "histogram", "functions": ["distribution"], "num_vars": "1", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},
    {"id": "density", "functions": ["distribution"], "num_vars": "1", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "many", "ordered_num": false},
    {"id": "boxplot", "functions": ["distribution", "comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "many", "ordered_num": false},
    {"id": "violin", "functions": ["distribution", "comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "many", "ordered_num": false},
    {"id": "ridgeline", "functions": ["distribution", "comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "many", "ordered_num": false},
    {"id": "beeswarm", "functions": ["distribution"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "many", "ordered_num": false,
      "caveats": ["Degrades above ~500 points per group"]},

    {"id": "pie", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["low_2_7"]}},
    {"id": "doughnut", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["low_2_7"]}},
    {"id": "waffle", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": false,
      "constraints": {"cardinality": ["low_2_7"]}},
    {"id": "treemap", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "many", "cat_structure": "nested", "obs_per_group": "one", "ordered_num": false},
    {"id": "sunburst", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "many", "cat_structure": "nested", "obs_per_group": "one", "ordered_num": false},
    {"id": "circular_packing", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "many", "cat_structure": "nested", "obs_per_group": "one", "ordered_num": false},
    {"id": "dendrogram", "functions": ["part_to_whole"], "num_vars": "1", "cat_vars": "many", "cat_structure": "nested", "obs_per_group": "one", "ordered_num": false},

    {"id": "line", "functions": ["trend_over_time"], "num_vars": "many", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "one", "ordered_num": true},
    {"id": "area", "functions": ["trend_over_time"], "num_vars": "1", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "one", "ordered_num": true},
    {"id": "stacked_area", "functions": ["part_to_whole", "trend_over_time"], "num_vars": "many", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": true,
      "constraints": {"max_num_series": 3},
      "caveats": ["Overlap illegible beyond 3 series; use line or small multiples"]},
    {"id": "stream_graph", "functions": ["trend_over_time", "part_to_whole"], "num_vars": "many", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": true},
    {"id": "connected_scatter", "functions": ["trend_over_time", "correlation"], "num_vars": "2", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "one", "ordered_num": true},
    {"id": "slope", "functions": ["trend_over_time", "comparison"], "num_vars": "1", "cat_vars": "1", "cat_structure": "flat", "obs_per_group": "one", "ordered_num": true,
      "caveats": ["Best with exactly 2 time points"]},
    {"id": "calendar_heatmap", "functions": ["trend_over_time"], "num_vars": "1", "cat_vars": "0", "cat_structure": "none", "obs_per_group": "one", "ordered_num": true,
      "caveats": ["Best for daily granularity over months/years; surfaces weekly seasonality"]},

    {"id": "network", "functions": ["correlation"], "is_relational": true},
    {"id": "chord", "functions": ["correlation", "part_to_whole"], "is_relational": true,
      "constraints": {"cardinality": ["low_2_7", "medium_8_20"]}},
    {"id": "arc", "functions": ["correlation"], "is_relational": true,
      "caveats": ["Prefer when node order is meaningful (sequence, rank)"]},
    {"id": "sankey", "functions": ["part_to_whole", "trend_over_time"], "is_relational": true},

    {"id": "choropleth", "functions": ["comparison"], "is_spatial": true, "spatial_grain": "region",
      "constraints": {"metric_type": ["rate", "score"]},
      "caveats": ["Raw counts mislead; use rates or proportional symbols"]},
    {"id": "proportional_symbol_map", "functions": ["comparison"], "is_spatial": true, "spatial_grain": "point"},
    {"id": "flow_map", "functions": ["trend_over_time", "comparison"], "is_spatial": true, "spatial_grain": "flow"},
    {"id": "isometric_cutaway", "functions": ["part_to_whole"], "physical_subject": true},
    {"id": "3d_globe", "functions": ["comparison"], "is_spatial": true, "spatial_grain": "point",
      "caveats": ["Only when global extent is itself the story; otherwise flat map"]}
  ],
  "shape_caveat_rules": [
    {"shape": "skewed", "applies_to": ["histogram", "density", "scatter", "bubble"], "caveat": "Consider log scale"},
    {"shape": "power_law", "applies_to": ["scatter", "connected_scatter"], "caveat": "Consider log-log scale"},
    {"shape": "bimodal", "applies_to": ["boxplot", "barplot"], "caveat": "Summaries hide bimodality; prefer violin/ridgeline"}
  ],
  "preconditions": {
    "min_completeness": 0.8,
    "min_sample_size": 5
  },
  "relax_order": ["distribution_shape", "spatial_grain", "cardinality", "metric_type", "ordered_num", "obs_per_group", "cat_structure", "cat_vars", "num_vars"]
}
