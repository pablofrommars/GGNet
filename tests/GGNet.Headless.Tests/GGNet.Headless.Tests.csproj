<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsTestProject>true</IsTestProject>

    <!-- CA1861 (hoist constant array args to static readonly): the gallery blocks
         are pinned verbatim to skills/ggnet/examples/*.md by
         SkillExampleConsistencyTests, and inline `new[] { 3.0 }` is the idiomatic
         DSL form those docs teach. The rule targets hot paths; these are one-shot
         [Fact] bodies. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>

    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="Verify.XunitV3" Version="31.27.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GGNet.Headless\GGNet.Headless.csproj" />
  </ItemGroup>

</Project>
